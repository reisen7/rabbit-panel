# 编译输出
.dist
backend/.dist
*.exe
rabbit-panel
rabbit-panel-*

# Go 相关
go.work
# 注意：go.mod 和 go.sum 应该提交到版本控制

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db

# TLS 证书 / 私钥（自签证书由面板自动生成，不要提交）
# 只忽略运行期证书目录，避免误伤测试用的证书夹具
data/certs/
backend/data/certs/

# 本机运行数据：微信凭证、Showdoc Token、智能体密钥等
data/*.json
backend/data/*.json
data/.ssh_secret_key
backend/data/.ssh_secret_key

# 临时文件
*.db
*.log
*.pid
*.tmp
tmp/
build-errors.log

# Air 热重载工具
.air.toml.bak
.kiro/
compose_projects

# 密钥/环境变量文件（含测试运行残留的数据目录）
data/secrets.env
backend/data/secrets.env
backend/config/data/
